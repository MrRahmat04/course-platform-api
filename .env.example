# Database configuration
DB_URL=jdbc:postgresql://localhost:5432/courses
DB_USER=app
DB_PASSWORD=replace-with-local-database-password

# JWT configuration (Base64-encoded key, minimum 32 bytes)
JWT_SECRET=replace-with-your-base64-encoded-secret

# Docker PostgreSQL configuration
POSTGRES_DB=courses
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-local-database-password
